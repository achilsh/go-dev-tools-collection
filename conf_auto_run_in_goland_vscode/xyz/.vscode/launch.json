{
    "version": "0.2.0",
    "configurations": [
        // 第一个配置：abc_build（保留之前的配置）
        {
            "name": "abc_build",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/abc",
            "args": [
                "-port",
                "1230"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "showLog": true
        },
        // 第二个配置：x2_build（新增的配置）
        {
            "name": "x2_build",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            // 对应 Goland 中的 package 路径 "github/xyz/cmd/x2"
            "program": "${workspaceFolder}/cmd/x2",
            // 对应 Goland 中的 parameters 参数
            "args": [
                "-port=123",
                "-debug=true",
                "-conf=${workspaceFolder}/conf/demo.yaml"
            ],
            // 工作目录保持和项目根目录一致
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "showLog": true
        }
    ]
}