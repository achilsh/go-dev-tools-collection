syntax = "v1"

// info() 
// 仅仅作为描述，不做代码生成
info (
    title: ""
    desc: ""
)

// 定义 自定义 struct 数据类型
type DefEempty {}

type IncludeBaseDef {
    Exist bool `json:"exist"`
    Nums uint8 `json:"nums"`
    N1 uint16 `json:"n1"`
    Nu32 uint32 `json:"nui32"`
    Nu64 uint64 `json:"nui64"`
    // 
    Ni8 int8 `json:"ni8"`
    Ni16 int16 `json:"ni16"`
    Ni32 int32 `json:"ni32"`
    Ni64 int64 `json:"ni64"`
    // 
    NF32 float32 `json:"nf32"`
    NF64 float64   `json:"nf64"`
    // 
    Ni int `json:"ni"`
    Nui uint `json:"nui"`
    NB byte `json:"nb"`
}


type MapDef {
    Age int `json:"age"`
    MapDat map[int]int `json:"mapData"`
}

type SliceDef {
    Nums []int `json:"nums"`
}

type ArrayDef {
    Nums [10]int `json:"nums"`
}

type ComposeData {
    Ns  SliceDef `json:"ns"`
    Ss SliceDef `json:"ss"`
    Md MapDef `json:"md"`
}

// 把Bar，Student 逻辑上放在一组，管理起来，代码会生成各个数据结构
type (
    Bar {
        Foo int               `json:"foo"`
        Bar bool              `json:"bar"`
        Baz []string          `json:"baz"`
        Qux map[string]string `json:"qux"`
    }
    Student {
        Age int `json:"age"`
        Name string `json:"name"`
    }
)