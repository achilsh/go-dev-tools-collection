syntax = "v1"

type Request {
	ID string `path:"id,options=you|me"`
}

type Response {
	Message string `json:"message"`
}

type PRequest {
	Name        string `json:"name,optional"`
	FromGateway string `json:"from_gateway,optional"`
	TMs         int64  `json:"timestamp,optional"`
}

type PResponse {
	Address string `json:"address"`
}

service userservice-api {
	@handler UserservicePingHandler
	get /api/v1/ping (Request) returns (Response)

	@handler UserserviceUserHandler
	get /api/v1/users returns (Response)

	@handler UserserviceUserIdHandler
	get /api/v1/users/:id (Request) returns (Response)

	@handler UserServicePostHandler
	post /api/v1/users/post (PRequest) returns (PResponse)
}

